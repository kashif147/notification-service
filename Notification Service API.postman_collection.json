{
  "info": {
    "name": "Notification Service API",
    "description": "API collection for Notification Service - Firebase Cloud Messaging endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "notification-service"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check if the service is running"
          },
          "response": []
        },
        {
          "name": "Events Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/events",
              "host": ["{{baseUrl}}"],
              "path": ["health", "events"]
            },
            "description": "Check RabbitMQ event system health"
          },
          "response": []
        },
        {
          "name": "Database Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/database",
              "host": ["{{baseUrl}}"],
              "path": ["health", "database"]
            },
            "description": "Check MongoDB database connection health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Firebase Notifications",
      "item": [
        {
          "name": "Token Management",
          "item": [
            {
              "name": "Register FCM Token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fcmToken\": \"your-fcm-token-here\",\n  \"userId\": \"user-id-here\",\n  \"tenantId\": \"tenant-id-here\",\n  \"deviceId\": \"device-id-optional\",\n  \"platform\": \"android\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/register-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "register-token"]
                },
                "description": "Register or update an FCM token for a user. If the token already exists, it will be updated."
              },
              "response": []
            },
            {
              "name": "Unregister FCM Token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fcmToken\": \"your-fcm-token-here\",\n  \"userId\": \"user-id-optional\",\n  \"tenantId\": \"tenant-id-optional\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/unregister-token",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "unregister-token"]
                },
                "description": "Unregister/deactivate an FCM token. Marks the token as inactive."
              },
              "response": []
            },
            {
              "name": "Get All Active Tokens",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/tokens?page=1&limit=50",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "tokens"],
                  "query": [
                    {
                      "key": "page",
                      "value": "1",
                      "description": "Page number (default: 1)"
                    },
                    {
                      "key": "limit",
                      "value": "50",
                      "description": "Items per page (default: 50)"
                    }
                  ]
                },
                "description": "Get all active FCM tokens with pagination. Returns tokens sorted by lastUsedAt in descending order."
              },
              "response": []
            },
            {
              "name": "Get Filtered Tokens",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/tokens/filter?tenantId=tenant-id&userId=user-id&platform=android&deviceId=device-id&isActive=true&page=1&limit=50",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "tokens", "filter"],
                  "query": [
                    {
                      "key": "tenantId",
                      "value": "tenant-id",
                      "description": "Filter by tenant ID (optional)",
                      "disabled": true
                    },
                    {
                      "key": "userId",
                      "value": "user-id",
                      "description": "Filter by user ID (optional)",
                      "disabled": true
                    },
                    {
                      "key": "platform",
                      "value": "android",
                      "description": "Filter by platform: ios, android, or web (optional)",
                      "disabled": true
                    },
                    {
                      "key": "deviceId",
                      "value": "device-id",
                      "description": "Filter by device ID (optional)",
                      "disabled": true
                    },
                    {
                      "key": "isActive",
                      "value": "true",
                      "description": "Filter by active status: true or false (default: true)",
                      "disabled": true
                    },
                    {
                      "key": "page",
                      "value": "1",
                      "description": "Page number (default: 1)"
                    },
                    {
                      "key": "limit",
                      "value": "50",
                      "description": "Items per page (default: 50)"
                    }
                  ]
                },
                "description": "Get FCM tokens filtered by tenantId, userId, platform, deviceId, or isActive status. All filters are optional and can be combined. Supports pagination."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Send Notifications",
          "item": [
            {
              "name": "Send Notification - By Token",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Notification Title\",\n  \"body\": \"Notification body text\",\n  \"fcmToken\": \"target-fcm-token-here\",\n  \"tenantId\": \"tenant-id-optional\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/send-notification",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "send-notification"]
                },
                "description": "Send a notification directly to a specific FCM token."
              },
              "response": []
            },
            {
              "name": "Send Notification - By User ID",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"title\": \"Notification Title\",\n  \"body\": \"Notification body text\",\n  \"userId\": \"user-id-here\",\n  \"tenantId\": \"tenant-id-required\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/send-notification",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "send-notification"]
                },
                "description": "Send a notification to all active FCM tokens registered for a user. Requires tenantId when using userId."
              },
              "response": []
            }
          ]
        },
        {
          "name": "Notification History",
          "item": [
            {
              "name": "Get Notifications",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/notifications?userId=user-id&tenantId=tenant-id&isRead=false&status=sent&page=1&limit=50",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "notifications"],
                  "query": [
                    {
                      "key": "userId",
                      "value": "user-id",
                      "description": "User ID (required)"
                    },
                    {
                      "key": "tenantId",
                      "value": "tenant-id",
                      "description": "Tenant ID (required)"
                    },
                    {
                      "key": "isRead",
                      "value": "false",
                      "description": "Filter by read status: true or false (optional)",
                      "disabled": true
                    },
                    {
                      "key": "status",
                      "value": "sent",
                      "description": "Filter by status: pending, sent, failed, or delivered (optional)",
                      "disabled": true
                    },
                    {
                      "key": "page",
                      "value": "1",
                      "description": "Page number (default: 1)"
                    },
                    {
                      "key": "limit",
                      "value": "50",
                      "description": "Items per page (default: 50)"
                    }
                  ]
                },
                "description": "Get notifications for a user with optional filters. Returns paginated list sorted by most recent first. Includes unread count."
              },
              "response": []
            },
            {
              "name": "Mark Notifications as Read",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Optional: JWT token for authenticated requests"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"notificationIds\": [\"notification-id-1\", \"notification-id-2\"],\n  \"userId\": \"user-id-here\",\n  \"tenantId\": \"tenant-id-here\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/notifications/mark-read",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "notifications", "mark-read"]
                },
                "description": "Mark one or more notifications as read. Users can only mark their own notifications. Requires userId and tenantId for security."
              },
              "response": []
            },
            {
              "name": "Delete Notification",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Required: JWT token for authenticated requests. userId and tenantId are extracted from the token."
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/notifications/:notificationId",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "notifications", ":notificationId"],
                  "variable": [
                    {
                      "key": "notificationId",
                      "value": "notification-id-here",
                      "description": "MongoDB ObjectId of the notification to delete"
                    }
                  ]
                },
                "description": "Delete a single notification (soft delete). Users can only delete their own notifications. userId and tenantId are extracted from the JWT token. Returns 404 if notification not found or already deleted."
              },
              "response": []
            },
            {
              "name": "Delete All Notifications",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}",
                    "description": "Required: JWT token for authenticated requests. userId and tenantId are extracted from the token."
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/firebase/notifications",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "firebase", "notifications"]
                },
                "description": "Delete all notifications for the authenticated user (soft delete). userId and tenantId are extracted from the JWT token. Returns the count of deleted notifications."
              },
              "response": []
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4010",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT access token for authenticated requests"
    }
  ]
}
