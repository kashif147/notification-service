{
  "name": "PDF Delivery Worker",
  "nodes": [
    {
      "id": "rabbit",
      "name": "RabbitMQ Trigger",
      "type": "n8n-nodes-base.rabbitmqTrigger",
      "parameters": {
        "queue": "pdf.delivery",
        "acknowledge": true
      },
      "credentials": { "rabbitmq": "RabbitMQ-Creds" },
      "position": [200, 200]
    },
    {
      "id": "parse",
      "type": "n8n-nodes-base.function",
      "name": "Parse",
      "position": [450, 200],
      "parameters": {
        "functionCode": "return [{ json: JSON.parse($json.message) }];"
      }
    },
    {
      "id": "template",
      "name": "Fetch Template",
      "type": "n8n-nodes-base.httpRequest",
      "position": [700, 200],
      "parameters": {
        "url": "https://projectshell-vm.northeurope.cloudapp.azure.com/communication-service/api/templates/{{$json.templateId}}",
        "method": "GET"
      }
    },
    {
      "id": "merge",
      "name": "Merge HTML",
      "type": "n8n-nodes-base.function",
      "position": [950, 200],
      "parameters": {
        "functionCode": "let html=$items(0).json.html;for(const[k,v]of Object.entries($json.variables)) html=html.replaceAll(`{{${k}}}`,v);return[{json:{...$json,html}}];"
      }
    },
    {
      "id": "pdf",
      "name": "HTML to PDF",
      "type": "n8n-nodes-base.htmlToPdf",
      "position": [1200, 200],
      "parameters": {
        "html": "={{$json.html}}"
      }
    },
    {
      "id": "upload",
      "name": "Upload to Azure Blob",
      "type": "n8n-nodes-base.azureBlobStorage",
      "position": [1450, 200],
      "parameters": {
        "operation": "upload",
        "containerName": "generated-letters",
        "fileName": "={{$json.tenantId}}/{{$json.notificationId}}.pdf"
      },
      "credentials": { "azureBlobApi": "Azure-Blob-Creds" }
    },
    {
      "id": "checkEmail",
      "name": "If emailAlso",
      "type": "n8n-nodes-base.if",
      "position": [1700, 200],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.emailAlso}}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "sendEmail",
      "name": "Send Email with PDF",
      "type": "n8n-nodes-base.awsSes",
      "position": [1950, 150],
      "parameters": {
        "fromEmail": "no-reply@yourdomain.com",
        "subject": "={{$json.subject}}",
        "text": "Your letter is attached.",
        "toEmail": "={{$json.to}}",
        "attachments": [
          {
            "binaryPropertyName": "data"
          }
        ]
      },
      "credentials": { "aws": "AWS-SES-Creds" }
    },
    {
      "id": "status",
      "name": "Update Status",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1950, 300],
      "parameters": {
        "method": "POST",
        "jsonParameters": true,
        "url": "https://projectshell-vm.northeurope.cloudapp.azure.com/notification-service/api/update-status",
        "body": {
          "notificationId": "={{$json.notificationId}}",
          "channel": "pdf",
          "status": "sent",
          "timestamp": "={{new Date().toISOString()}}"
        }
      }
    }
  ],
  "connections": {
    "parse": { "main": [[{ "node": "template" }]] },
    "template": { "main": [[{ "node": "merge" }]] },
    "merge": { "main": [[{ "node": "pdf" }]] },
    "pdf": { "main": [[{ "node": "upload" }]] },
    "upload": { "main": [[{ "node": "checkEmail" }]] },
    "checkEmail": {
      "main": [[{ "node": "sendEmail" }], [{ "node": "status" }]]
    },
    "sendEmail": { "main": [[{ "node": "status" }]] }
  }
}
