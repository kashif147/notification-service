{
  "name": "Email Delivery Worker",
  "nodes": [
    {
      "id": "rabbitmqTrigger",
      "name": "RabbitMQ Trigger",
      "type": "n8n-nodes-base.rabbitmqTrigger",
      "position": [200, 200],
      "parameters": {
        "queue": "email.delivery",
        "acknowledge": true
      },
      "credentials": { "rabbitmq": "RabbitMQ-Creds" }
    },
    {
      "id": "parsePayload",
      "name": "Parse Payload",
      "type": "n8n-nodes-base.function",
      "position": [450, 200],
      "parameters": {
        "functionCode": "return [{ json: JSON.parse($json.message) }];"
      }
    },
    {
      "id": "fetchTemplate",
      "name": "Fetch Template",
      "type": "n8n-nodes-base.httpRequest",
      "position": [700, 200],
      "parameters": {
        "url": "https://projectshell-vm.northeurope.cloudapp.azure.com/communication-service/api/templates/{{$json.templateId}}",
        "method": "GET"
      }
    },
    {
      "id": "mergeTemplate",
      "name": "Merge Template",
      "type": "n8n-nodes-base.function",
      "position": [950, 200],
      "parameters": {
        "functionCode": "let content = $items(0).json.body;\nfor (const [k,v] of Object.entries($json.variables)) {\n  content = content.replaceAll(`{{${k}}}`, v);\n}\nreturn [{ json: { ...$json, content } }];"
      }
    },
    {
      "id": "sendEmailSES",
      "name": "Send Email (SES)",
      "type": "n8n-nodes-base.awsSes",
      "position": [1200, 200],
      "parameters": {
        "fromEmail": "no-reply@yourdomain.com",
        "subject": "{{$json.subject}}",
        "text": "{{$json.content}}",
        "toEmail": "{{$json.to}}"
      },
      "credentials": { "aws": "AWS-SES-Creds" }
    },
    {
      "id": "updateStatus",
      "name": "Update Status",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1450, 200],
      "parameters": {
        "url": "https://projectshell-vm.northeurope.cloudapp.azure.com/notification-service/api/update-status",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "body": {
          "notificationId": "={{$json.notificationId}}",
          "channel": "email",
          "status": "sent",
          "timestamp": "={{new Date().toISOString()}}"
        }
      }
    }
  ],
  "connections": {
    "parsePayload": {
      "main": [[{ "node": "fetchTemplate", "type": "main", "index": 0 }]]
    },
    "fetchTemplate": {
      "main": [[{ "node": "mergeTemplate", "type": "main", "index": 0 }]]
    },
    "mergeTemplate": {
      "main": [[{ "node": "sendEmailSES", "type": "main", "index": 0 }]]
    },
    "sendEmailSES": {
      "main": [[{ "node": "updateStatus", "type": "main", "index": 0 }]]
    }
  }
}
